{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prompt Compose",
  "version": "0.3.3",
  "identifier": "com.zhangxingeng.promptcompose",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Prompt Compose",
        "width": 1100,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "opener": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "endpoints": [
        "https://github.com/zhangxingeng/prompt-compose/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1QzM1NURFMTY5MDBDOUMKUldTY0RKQVczbFhEWlIvQ0F4d08yZXdsOFhlL1U0M2dvYXlSbWpvY1pPbmVWWkhVV0JlRm5FUVoK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Local-first Markdown prompt library organized by projects and folders.",
    "longDescription": "Prompt Compose is a local-first macOS Prompt Library for browsing, editing and organizing Markdown prompts. A project is a real folder and each prompt is a normal Markdown file, so users can keep libraries in Finder, VS Code, Obsidian or Git. Optional YAML frontmatter adds descriptions, tags, lifecycle status, favorites and model hints. Search, preview, safe atomic editing and copying work without a cloud account, AI API key or Accessibility permission.",
    "publisher": "zhangxingeng",
    "copyright": "Copyright (c) 2026 zhangxingeng. MIT licensed.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {}
  }
}
